{
  "name": "svelte-maplibre",
  "version": "2.0.0",
  "description": "Svelte bindings for MapLibre",
  "author": {
    "name": "Daniel Imfeld",
    "url": "https://imfeld.dev"
  },
  "repository": {
    "url": "https://github.com/dimfeld/svelte-maplibre"
  },
  "homepage": "https://svelte-maplibre.imfeld.dev",
  "license": "MIT",
  "keywords": [
    "gis",
    "map",
    "maplibre",
    "svelte"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && pnpm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepare": "husky && pnpm run package",
    "test": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "changeset": "changeset",
    "generate-changelog": "GITHUB_TOKEN=$(gh auth token) changeset version",
    "lint": "prettier --check src && eslint .",
    "format": "prettier --write src"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.css": {
      "default": "./dist/*.css"
    },
    "./*.svelte": {
      "types": "./dist/*.d.ts",
      "svelte": "./dist/*.svelte",
      "default": "./dist/*.svelte"
    },
    "./context.svelte.js": {
      "types": "./dist/context.svelte.d.ts",
      "default": "./dist/context.svelte.js"
    },
    "./expressions.js": {
      "types": "./dist/expressions.d.ts",
      "default": "./dist/expressions.js"
    },
    "./filters.js": {
      "types": "./dist/filters.d.ts",
      "default": "./dist/filters.js"
    },
    "./source.js": {
      "types": "./dist/source.d.ts",
      "default": "./dist/source.js"
    },
    "./types.js": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "dependencies": {
    "d3-geo": "^3.1.0",
    "dequal": "^2.0.3",
    "just-compare": "^2.3.0",
    "maplibre-gl": "^6.7.0",
    "pmtiles": "^3.0.3"
  },
  "peerDependencies": {
    "@deck.gl/core": "^9",
    "@deck.gl/layers": "^9",
    "@deck.gl/mapbox": "^9",
    "svelte": "^5.0.0",
    "topojson-client": "^3.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@deck.gl/core": "~9.3.2",
    "@deck.gl/layers": "~9.3.2",
    "@deck.gl/mapbox": "~9.3.2",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.17.0",
    "@mapbox/mapbox-gl-draw": "^1.5.0",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/d3-color": "^3.1.3",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^22.18.12",
    "@types/topojson-client": "^3.1.0",
    "@types/topojson-specification": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "d3-color": "^3.1.0",
    "dedent": "^1.7.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "highlight.js": "^11.11.1",
    "highlightjs-svelte": "^1.0.6",
    "husky": "^9.1.7",
    "just-clamp": "^4.2.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "publint": "^0.3.21",
    "svelte": "^5.56.0",
    "svelte-check": "^4.4.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "topojson-client": "^3.1.0",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "peerDependenciesMeta": {
    "@deck.gl/core": {
      "optional": true
    },
    "@deck.gl/layers": {
      "optional": true
    },
    "@deck.gl/mapbox": {
      "optional": true
    },
    "topojson-client": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.34.1"
}
